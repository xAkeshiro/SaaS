# Site demo: a key from the Anthropic "demo" workspace (give it a daily spend limit). Either key makes the demo live;
# leave both empty and /api/rehearse serves the scripted sample.
ANTHROPIC_DEMO_API_KEY=
ANTHROPIC_API_KEY=
# Models. Defaults: persona claude-sonnet-5-5, debrief claude-opus-5-5, safety checks claude-haiku-4-5.
UNMUTE_PERSONA_MODEL=
UNMUTE_DEBRIEF_MODEL=
UNMUTE_CLASSIFIER_MODEL=
# Optional secret for signing persona lines. Unset: derived from the Anthropic key.
DEMO_SIGNING_SECRET=
# Shared rate limits (Upstash, or Vercel KV's KV_REST_API_URL / KV_REST_API_TOKEN). Unset: per-instance limits.
UPSTASH_REDIS_REST_URL=
UPSTASH_REDIS_REST_TOKEN=
# Waitlist and pilot requests (see supabase/migrations). The secret key stays on the server.
NEXT_PUBLIC_SUPABASE_URL=
SUPABASE_SECRET_KEY=
# Fallback when Supabase is unset: signups are POSTed here as JSON.
WAITLIST_WEBHOOK_URL=
# Email the owner on each Teams pilot request.
RESEND_API_KEY=
OWNER_NOTIFY_EMAIL=
RESEND_FROM=
# Public origin of the deployed site, used for metadata and absolute URLs (e.g. https://unmute.app).
NEXT_PUBLIC_SITE_URL=
