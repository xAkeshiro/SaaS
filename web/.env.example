# Anthropic API key for the preview rehearsal. Leave empty and /api/rehearse serves the scripted sample.
ANTHROPIC_API_KEY=
# Model for the persona and the coach. Defaults to claude-opus-5 when unset.
UNMUTE_MODEL=claude-opus-5
# Optional webhook that receives waitlist signups as JSON. Unset: signups are logged to the console.
WAITLIST_WEBHOOK_URL=
# Public origin of the deployed site, used for metadata and absolute URLs (e.g. https://unmute.app).
NEXT_PUBLIC_SITE_URL=
